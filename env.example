# ═══════════════════════════════════════════════════════════════════
# PeakInsights Hub — BACKEND environment variables
# Copy to .env (local) or add each one in Vercel → Settings → Environment
# Variables. Never commit the real values.
# Lines marked [NEW] were added with email attachments / announcements.
# ═══════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URLs. BACKEND_URL is used to build signed file links;
# FRONTEND_URL is used in email links and CORS.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/peakinsights

# ── Auth ───────────────────────────────────────────────────────────
# Long random string. Also used to sign file links and attachment upload tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Encrypts stored Zoho mailbox + calendar tokens. Must be 64 hex chars (32 bytes):
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Initial CEO account (used by the seed script) ──────────────────
CEO_NAME=
CEO_EMAIL=
CEO_PASSWORD=
CEO_DEPARTMENT=
SEED_CEO_PASSWORD=

# ── File storage (S3) ──────────────────────────────────────────────
# Bucket must be PRIVATE. For browser attachment uploads [NEW] it also needs
# a CORS rule allowing POST from FRONTEND_URL (see s3-cors-config.json).
# NOTE: named S3_ACCESS_KEY, not AWS_ACCESS_KEY — Vercel reserves that prefix.
AWS_REGION=us-east-1
S3_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=
# Local-only fallback directory used by the document worker.
UPLOAD_DIR=./uploads

# ── Outgoing email (Resend) ────────────────────────────────────────
# Outbound mail goes through Resend (resend.com). Verify your domain at
# resend.com/domains first, then create an API key at resend.com/api-keys.
RESEND_API_KEY=
# The domain verified in Resend.
MAIL_FROM_DOMAIN=peak-insights.com
# Every email is sent from this one address. When a person composed it, the
# From name reads "Nelson Kyebei via PeakInsights Hub" and Reply-To is that
# person's own address. Defaults to peakinsights@<MAIL_FROM_DOMAIN>.
MAIL_FROM_ADDRESS=peakinsights@peak-insights.com

# ── Management Accounts & Reports ──────────────────────────────────
# Client report emails are sent under the CEO's official identity (From and
# Reply-To). The address is authorised if EITHER:
#   - it is on the same domain as MAIL_FROM_ADDRESS (already verified in Resend), or
#   - you name it here explicitly. Use this when the CEO's official address
#     differs from his Hub login email (e.g. ceo@peak-insights.com).
# This does NOT require MAIL_FROM_DOMAIN, and setting it changes nothing else
# (invites etc. keep using the shared address). The domain must be verified in
# Resend, otherwise the send fails with a clear "Delivery Failed" reason.
CEO_SENDER_EMAIL=
# Optional display name for the CEO on report emails (default: the CEO's Hub name).
CEO_SENDER_NAME=
# While an MA stays overdue, re-notify the accountants every N days (default 3).
MA_OVERDUE_REMINDER_DAYS=3
# NOTE: Zoho is still used for INBOUND sync (ZOHO_* vars) — unchanged.

# ── Email attachments & announcements [NEW] ────────────────────────
# Total attachment size allowed per email, in MB. Providers reject messages
# over ~20 MB and base64 adds a third, so keep this at 15 or below.
EMAIL_MAX_ATTACHMENT_MB=15
# Who may email EVERYONE. Default is every role; set a comma-separated list
# to restrict it, e.g. ceo,tech,supervisor
EMAIL_BROADCAST_ROLES=ceo,tech,supervisor,sales_person,accountant
# Announcements one person may send per hour (0 = no limit). Protects the
# shared SMTP account from being flagged for bulk sending.
EMAIL_BROADCAST_MAX_PER_HOUR=10
# Recipients per message when sending an announcement (BCC batches).
EMAIL_BROADCAST_BATCH_SIZE=40

# ── Zoho Mail sync (reads staff mailboxes) ─────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://YOUR-API-DOMAIN/api/integrations/zoho/callback
# Use the region your Zoho org lives in (eu → .eu, in → .in, au → .com.au, jp → .jp)
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_MAIL_API_DOMAIN=mail.zoho.com
# How often the in-process sync runs when Redis isn't available (ms).
EMAIL_SYNC_INTERVAL_MS=300000

# ── Scheduled jobs ─────────────────────────────────────────────────
# Shared secret the cron caller must send to hit /api/cron/* endpoints.
CRON_SECRET=

# ── Redis / queues (optional — falls back to in-process when unset) ─
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Zoho Calendar + Zoho Meeting (meetings on staff calendars) ─────
# Uses the same Zoho API Console client as Zoho Mail above (ZOHO_CLIENT_ID /
# ZOHO_CLIENT_SECRET / ZOHO_ACCOUNTS_DOMAIN). Add this URI to that client's
# Authorized Redirect URIs. Scopes requested: ZohoCalendar.calendar.READ,
# ZohoCalendar.event.ALL, ZohoMeeting.meeting.ALL, AaaServer.profile.READ.
ZOHO_CALENDAR_REDIRECT_URI=https://YOUR-API-DOMAIN/api/integrations/zoho-calendar/callback
# Optional — derived from ZOHO_ACCOUNTS_DOMAIN's region when unset:
# ZOHO_CALENDAR_API_DOMAIN=calendar.zoho.com
# ZOHO_MEETING_DOMAIN=meeting.zoho.com
# Optional — only if Calendar should use a different Zoho client than Mail:
# ZOHO_CALENDAR_CLIENT_ID=
# ZOHO_CALENDAR_CLIENT_SECRET=
# Experimental: ask Zoho to show the account picker on Calendar connect (untested; Zoho only documents prompt=consent).
# ZOHO_CALENDAR_FORCE_ACCOUNT_PICKER=true

# ── WhatsApp Business ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
META_APP_SECRET=

# ── Departments treated as "Tech" (comma-separated) ────────────────
TECH_DEPARTMENT_NAMES=ICT,Tech,Technology,IT

# ── ICT heartbeat / check-in scripts (scripts/ict-*.ts) ────────────
# Only needed on the machines that run those scripts.
# API_URL=https://YOUR-API-DOMAIN/api
# API_TOKEN=
# SYSTEM_ID=
# STATUS=healthy            # healthy | warning | critical
# TARGET_URL=
# STATUS_OVERRIDE=
# INTERVAL_SECONDS=60

# ── Error reports for the tech supervisor ───────────────────────────
# Errors anywhere in the system (API 5xx, crashes, failed background jobs,
# browser errors) and problems reported by users appear in the "Error Reports"
# workspace and ring the notification bell of every ACTIVE supervisor whose
# department is a Tech one (ICT / IT / Tech …). Nothing to configure for that.
#
# EMAIL IS OFF BY DEFAULT. Set to true to ALSO send emails (alerts, user
# reports with screenshots attached, replies).
ERROR_EMAILS_ENABLED=false
# Only used when ERROR_EMAILS_ENABLED=true: extra addresses that also get every
# alert, and the only recipients if the DATABASE is down (the app cannot look
# supervisors up then).
ERROR_ALERT_EMAILS=
# Only errors at or above this severity notify (bell/email). low | medium | high
# | critical. Default medium, so "low" = warning: listed in Error Reports only.
ERROR_ALERT_MIN_SEVERITY=medium
# The same error repeating is ONE report. While it is still "new" (nobody has
# acknowledged it) it re-notifies at most this often. Default 60.
ERROR_ALERT_COOLDOWN_MINUTES=60
# Safety valve: at most this many notifications per hour in total. Reports are
# still stored. Default 30.
ERROR_ALERT_MAX_PER_HOUR=30
# Set to false to switch error reporting off entirely (it is off under Jest).
ERROR_REPORTING_ENABLED=true
#
# Screenshots are stored in S3 (S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET /
# AWS_REGION above). Without them, reports can still be sent — just without images.
