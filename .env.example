NODE_ENV=development
PORT=5000
MONGODB_URI=MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,txt,csv
FRONTEND_URL=http://localhost:5173

# ── CEO Seed Account (used only if no CEO exists in the DB) ──
CEO_NAME=PeakInsights CEO
CEO_EMAIL=ceo@peakinsights.com
CEO_PASSWORD=PeakInsights@2025
CEO_DEPARTMENT=Executive

NODE_ENV=development
PORT=5000
MONGODB_URI=MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,txt,csv
FRONTEND_URL=http://localhost:5173

# ── Token encryption (required for Zoho/email OAuth token storage) ──
# 32-byte key, hex-encoded (64 hex chars). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Zoho OAuth (email integration) ──
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# ── CEO Seed Account (used only if no CEO exists in the DB) ──
CEO_NAME=PeakInsights CEO
CEO_EMAIL=ceo@peakinsights.com
CEO_PASSWORD=PeakInsights@2025
CEO_DEPARTMENT=Executive
