{
  "version": 2,
  "buildCommand": "echo No project build needed - api files are compiled independently by the Vercel Node runtime",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/index-large.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/index-large-documents",
      "destination": "/api/index-large"
    },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}